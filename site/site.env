# Die eine Datei, die Adresse und Kontakt nennt. Ohne Kontakt und Anschrift bricht der Build ab.
SITE_ORIGIN=https://hai.konradvoelkel.com
SITE_BASE=/eidl/
SITE_SKRIPT=https://eidl-skript-131e30.pages.cs.uni-duesseldorf.de/
# Wo der Quelltext liegt (AGPL §13): Die Seite „Über hAInrich2“ verlinkt ihn. Leer, solange das Repository nicht öffentlich ist; dann
# fehlt der Abschnitt „Quelltext“ ganz, statt auf eine Seite zu zeigen, die es für Fremde nicht gibt.
SITE_QUELLTEXT=
# je Projekt eine eigene Adresse (RECHTSTEXTE §1), mail@hai.konradvoelkel.com in der Schreibweise der Impressen
SITE_KONTAKT=mail [at] hai [punkt] konradvoelkel [punkt] com
# wie Laberampel (Konrad, 2026-11-04); | trennt die Zeilen
SITE_ANSCHRIFT=Universitätsstr. 1|40225 Düsseldorf
